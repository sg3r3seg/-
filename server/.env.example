# LiveX server configuration (copy to server/.env). Never commit the real file.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
# Public HTTPS address of the website/API (used in email links). Required to be https:// in production.
PUBLIC_URL=https://your-livex-domain.example
# Set to 1 when running behind a reverse proxy (nginx/Caddy) so client IPs are correct for rate limiting.
TRUST_PROXY=1
DATA_DIR=./data
KEYS_DIR=./keys

# Payments: 'stripe' in production ('sandbox' is refused when NODE_ENV=production)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (activation codes, verification, password reset, transfer confirmation)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LiveX <no-reply@your-livex-domain.example>

# Admin API (revoke licenses, mark offline payments paid). At least 32 random characters.
ADMIN_TOKEN=

# Licensing policy
LEASE_TTL_HOURS=48
ACTIVATION_CODE_TTL_DAYS=30
ACTIVATION_MAX_FAILURES=5
ACTIVATION_FAILURE_WINDOW_MIN=15
MAX_DEVICES_PER_LICENSE=1
TRANSFER_LIMIT_PER_YEAR=3

# Optional AI voices for LiveX TTS (key stays on the server)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Platform sign-in (OAuth). Register a LiveX app with each platform and set the redirect URI to
#   <PUBLIC_URL>/api/oauth/callback/<youtube|twitch|kick|tiktok|discord>
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_TWITCH_CLIENT_ID=
OAUTH_TWITCH_CLIENT_SECRET=
OAUTH_KICK_CLIENT_ID=
OAUTH_KICK_CLIENT_SECRET=
# TikTok Login Kit: enable the user.info.basic and user.info.profile scopes (the giveaway
# winner check needs the @username from user.info.profile).
OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
