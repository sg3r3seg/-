{
  "name": "livex",
  "productName": "LiveX",
  "version": "1.0.0",
  "description": "LiveX — ONE PLATFORM. EVERY CREATOR. Live-stream management for creators.",
  "author": "LiveX",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.js",
    "dist:win": "node scripts/build-installer.js",
    "test:e2e-oauth": "node test/e2e/oauth.e2e.js",
    "test:e2e-winners": "node test/e2e/winners.e2e.js"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "44.11.5",
    "electron-builder": "26.0.12",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "app.livex.desktop",
    "productName": "LiveX",
    "copyright": "LiveX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config/livex.config.json",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LiveX-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "afterPack": "scripts/after-pack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sg3r3seg/-.git"
  }
}
